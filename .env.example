# App
NODE_ENV=development
PORT=3000

# Database — format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/nestjs_db"

# JWT — WAJIB diganti dengan string acak yang panjang di production.
# Contoh generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# HR
APP_TIMEZONE=Asia/Jakarta
LEAVE_DEFAULT_QUOTA=12

# Akun admin awal (dipakai oleh `npm run prisma:seed`)
SEED_ADMIN_EMAIL=admin@hr.local
SEED_ADMIN_PASSWORD=Admin123!
